# The dashboard's settings, for a local Clavia started with `make up` and seeded with
# `make seed` (which prints these same values for your CLAVIA_ROOT_DOMAIN). Copy this
# file to .env.local and adjust the domain if yours is not clavia.test.
#
# Node must trust the local certificate authority Clavia's certificates come from:
#   export NODE_EXTRA_CA_CERTS="$(mkcert -CAROOT)/rootCA.pem"

# Clavia's issuer, as its discovery document states it.
CLAVIA_ISSUER=https://auth.clavia.test
# The development client `clavia seed-dev` registers. A real deployment registers its
# own confidential client and keeps its secret out of the repository.
CLAVIA_CLIENT_ID=clavia-dashboard
CLAVIA_CLIENT_SECRET=dev-dashboard-secret-for-local-development-only
# The Management API: its identifier, which is also where it is served.
CLAVIA_MANAGEMENT_API=https://management.clavia.test/api/v1/
# Where browsers reach the dashboard (Caddy proxies it from port 3000).
DASHBOARD_URL=https://management.clavia.test/dashboard

# 32 random bytes, base64url: encrypts the session records.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DASHBOARD_SESSION_SECRET=
# Clavia's development Redis, in a database of the dashboard's own.
DASHBOARD_REDIS_URL=redis://localhost:6379/2
# Optional, in seconds: how long a session lasts at most (8 hours), and without use (1 hour).
# DASHBOARD_SESSION_LIFETIME=28800
# DASHBOARD_SESSION_IDLE_TIMEOUT=3600
